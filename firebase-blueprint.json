{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Catalog product item with bilingual names, pricing, variations, and inventory.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 160 },
        "sku": { "type": "string", "maxLength": 64 },
        "nameEn": { "type": "string", "maxLength": 200 },
        "nameBn": { "type": "string", "maxLength": 200 },
        "descriptionEn": { "type": "string", "maxLength": 4000 },
        "descriptionBn": { "type": "string", "maxLength": 4000 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "brand": { "type": "string", "maxLength": 100 },
        "regularPrice": { "type": "number" },
        "discountPrice": { "type": "number" },
        "stock": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "featured": { "type": "boolean" },
        "bestSeller": { "type": "boolean" },
        "trending": { "type": "boolean" },
        "newArrival": { "type": "boolean" },
        "published": { "type": "boolean" },
        "ratingAvg": { "type": "number" },
        "ratingCount": { "type": "number" },
        "soldCount": { "type": "number" }
      },
      "required": ["slug", "sku", "nameEn", "nameBn", "categoryId", "regularPrice", "stock", "published"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category or subcategory with bilingual labels.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 120 },
        "nameEn": { "type": "string", "maxLength": 120 },
        "nameBn": { "type": "string", "maxLength": 120 },
        "parentId": { "type": "string", "maxLength": 128 },
        "image": { "type": "string", "maxLength": 500 },
        "sortOrder": { "type": "number" }
      },
      "required": ["slug", "nameEn", "nameBn"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer account profile isolated per user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 30 },
        "phoneVerified": { "type": "boolean" },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "isActive": { "type": "boolean" }
      },
      "required": ["uid", "fullName", "email", "isActive"]
    },
    "Address": {
      "title": "Address",
      "description": "Saved customer delivery address.",
      "type": "object",
      "properties": {
        "label": { "type": "string", "maxLength": 60 },
        "fullName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "district": { "type": "string", "maxLength": 80 },
        "upazila": { "type": "string", "maxLength": 80 },
        "deliveryArea": { "type": "string", "maxLength": 120 },
        "streetAddress": { "type": "string", "maxLength": 300 },
        "isDefault": { "type": "boolean" }
      },
      "required": ["fullName", "phone", "district", "upazila", "streetAddress"]
    },
    "Order": {
      "title": "Order",
      "description": "Server-validated customer or guest order with status timeline.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "maxLength": 40 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "customerEmail": { "type": "string", "maxLength": 160 },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 40 },
        "paymentStatus": { "type": "string", "maxLength": 40 },
        "orderStatus": { "type": "string", "maxLength": 40 },
        "transactionId": { "type": "string", "maxLength": 120 }
      },
      "required": ["orderNumber", "customerName", "customerPhone", "subtotal", "deliveryCharge", "grandTotal", "paymentMethod", "paymentStatus", "orderStatus"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer product review.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 }
      },
      "required": ["productId", "userId", "userName", "rating", "comment"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon managed by admins.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 40 },
        "type": { "type": "string", "maxLength": 20 },
        "value": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "usageLimit": { "type": "number" },
        "usedCount": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["code", "type", "value", "active"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User order, payment, and promotional notifications.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 40 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "titleBn": { "type": "string", "maxLength": 200 },
        "bodyEn": { "type": "string", "maxLength": 600 },
        "bodyBn": { "type": "string", "maxLength": 600 },
        "read": { "type": "boolean" },
        "orderNumber": { "type": "string", "maxLength": 40 }
      },
      "required": ["type", "titleEn", "titleBn", "bodyEn", "bodyBn", "read"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Role-based admin assignment.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "order_manager", "product_manager"] },
        "active": { "type": "boolean" }
      },
      "required": ["uid", "email", "role", "active"]
    },
    "AdminNotification": {
      "title": "AdminNotification",
      "description": "System alerts for administrators.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 40 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "titleBn": { "type": "string", "maxLength": 200 },
        "read": { "type": "boolean" }
      },
      "required": ["type", "titleEn", "titleBn", "read"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable admin action audit trail.",
      "type": "object",
      "properties": {
        "adminUid": { "type": "string", "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 160 },
        "actionType": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 600 },
        "timestamp": { "type": "string", "maxLength": 60 }
      },
      "required": ["adminUid", "adminEmail", "actionType", "description", "timestamp"]
    }
  },
  "firestore": {
    "/products/{productId}": { "schema": { "$ref": "#/entities/Product" }, "description": "Catalog products" },
    "/categories/{categoryId}": { "schema": { "$ref": "#/entities/Category" }, "description": "Product categories" },
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserProfile" }, "description": "Private customer profiles" },
    "/users/{userId}/addresses/{addressId}": { "schema": { "$ref": "#/entities/Address" }, "description": "Saved delivery addresses" },
    "/users/{userId}/notifications/{notifId}": { "schema": { "$ref": "#/entities/Notification" }, "description": "Customer notifications" },
    "/orders/{orderId}": { "schema": { "$ref": "#/entities/Order" }, "description": "Customer and guest orders" },
    "/reviews/{reviewId}": { "schema": { "$ref": "#/entities/Review" }, "description": "Product reviews" },
    "/coupons/{couponId}": { "schema": { "$ref": "#/entities/Coupon" }, "description": "Promo coupons" },
    "/admins/{adminUid}": { "schema": { "$ref": "#/entities/AdminMember" }, "description": "Admin role records" },
    "/admin_notifications/{notifId}": { "schema": { "$ref": "#/entities/AdminNotification" }, "description": "Admin alert notifications" },
    "/audit_logs/{logId}": { "schema": { "$ref": "#/entities/AdminAuditLog" }, "description": "Admin audit trail" }
  }
}
